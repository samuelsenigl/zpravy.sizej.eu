{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "christian-magazine",
  "compatibility_date": "2024-05-09",
  "pages_build_output_dir": "./",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "zpravy.sizej.eu",
      "custom_domain": true
    },
    {
      "pattern": "zpravy.sizej.eu/*",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
